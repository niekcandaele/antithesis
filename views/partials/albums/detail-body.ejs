<!-- Breadcrumbs -->
<nav class="breadcrumb mb-5" aria-label="breadcrumbs">
  <ul>
    <li><a href="/">Home</a></li>
    <li><a href="/albums">Albums</a></li>
    <li class="is-active"><a href="#" aria-current="page"><%= album.name %></a></li>
  </ul>
</nav>

<!-- Album Header -->
<div class="box mb-5">
  <div class="level">
    <div class="level-left" style="flex: 1;">
      <div>
        <h1 class="title is-3 mb-2">
          <%= album.name %>
          <span class="tag <%= album.status === 'published' ? 'is-success' : album.status === 'draft' ? 'is-warning' : 'is-info' %> ml-2">
            <%= album.status %>
          </span>
          <% if (album.isDeleted) { %>
            <span class="tag is-danger ml-2">Deleted</span>
          <% } %>
        </h1>
        <% if (album.description) { %>
          <p class="subtitle is-6 has-text-grey"><%= album.description %></p>
        <% } %>
        <p class="is-size-7 has-text-grey-light mt-2">
          <% if (album.creatorEmail) { %>
            Created by <%= album.creatorEmail %> on <%= new Date(album.createdAt).toLocaleDateString() %>
          <% } else { %>
            Created <%= new Date(album.createdAt).toLocaleDateString() %>
          <% } %>
        </p>
      </div>
    </div>
    <div class="level-right">
      <div class="buttons">
        <% if (!album.isDeleted) { %>
          <a href="/photos/new?albumId=<%= album.id %>" class="button is-primary">
            <span class="icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
            </span>
            <span>Add Photo</span>
          </a>
          <a href="/albums/<%= album.id %>/edit" class="button is-link">Edit Album</a>
          <form method="POST" action="/albums/<%= album.id %>/delete" onsubmit="return confirm('Are you sure you want to delete this album?');" style="display: inline;">
            <button type="submit" class="button is-danger">Delete</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Photos Grid -->
<div class="mb-5">
  <h2 class="title is-4 mb-4">Photos (<%= photos.length %>)</h2>

  <% if (photos.length === 0) { %>
    <div class="box has-text-centered">
      <p class="subtitle is-5">No photos in this album yet.</p>
      <% if (!album.isDeleted) { %>
        <div class="buttons is-centered mt-4">
          <a href="/photos/new?albumId=<%= album.id %>" class="button is-primary">Add First Photo</a>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <div id="photos-grid" class="columns is-multiline">
      <% photos.forEach(photo => { %>
        <div class="column is-one-quarter-desktop is-one-third-tablet is-half-mobile">
          <div class="box <%= photo.isDeleted ? 'has-opacity-50' : '' %>" style="<%= photo.isDeleted ? 'opacity: 0.5;' : '' %>position: relative;">
            <figure class="image is-square" style="position: relative;">
              <% if (photo.thumbnailUrl || photo.url) { %>
                <img src="<%= photo.thumbnailUrl || photo.url %>" alt="<%= photo.title %>" style="object-fit: cover; width: 100%; height: 100%;" />
              <% } else { %>
                <div style="background-color: #f5f5f5; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="opacity: 0.2;">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
              <% } %>
              <span class="tag <%= photo.status === 'published' ? 'is-success' : photo.status === 'draft' ? 'is-warning' : 'is-info' %>" style="position: absolute; top: 0.5rem; right: 0.5rem;">
                <%= photo.status %>
              </span>
            </figure>
            <div class="content mt-3">
              <p class="is-size-6 has-text-weight-semibold">
                <%= photo.title %>
                <% if (photo.isDeleted) { %>
                  <span class="tag is-danger is-small ml-2">Deleted</span>
                <% } %>
              </p>
              <% if (photo.description) { %>
                <p class="is-size-7 has-text-grey"><%= photo.description.substring(0, 60) %><%= photo.description.length > 60 ? '...' : '' %></p>
              <% } %>
              <div class="buttons is-right mt-3">
                <% if (photo.url) { %>
                  <a href="<%= photo.url %>" target="_blank" class="button is-small is-ghost">View</a>
                <% } %>
                <% if (!photo.isDeleted) { %>
                  <a href="/photos/<%= photo.id %>/edit" class="button is-small is-primary">Edit</a>
                  <form method="POST" action="/photos/<%= photo.id %>/delete" onsubmit="return confirm('Delete this photo?');" style="display: inline;">
                    <button type="submit" class="button is-small is-danger">Delete</button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
