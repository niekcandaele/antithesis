<div class="content has-text-centered">
  <div class="block">
    <h1 class="title is-1"><%= statusCode %></h1>
  </div>

  <div class="block">
    <% if (statusCode === 403) { %>
      <h2 class="title is-3">Access Forbidden</h2>
      <p class="subtitle is-5">You don't have permission to access this resource.</p>
    <% } else if (statusCode === 404) { %>
      <h2 class="title is-3">Not Found</h2>
      <p class="subtitle is-5">The page or resource you're looking for doesn't exist.</p>
    <% } else if (statusCode === 500) { %>
      <h2 class="title is-3">Server Error</h2>
      <p class="subtitle is-5">Something went wrong on our end. Please try again later.</p>
    <% } else { %>
      <h2 class="title is-3">Error</h2>
      <p class="subtitle is-5"><%= message || 'An error occurred' %></p>
    <% } %>
  </div>

  <% if (details) { %>
    <div class="block">
      <div class="notification is-danger has-text-left">
        <div class="content">
          <div class="is-flex is-align-items-center mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="icon mr-2" style="width: 24px; height: 24px;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <strong>Development Mode - Error Details</strong>
          </div>
          <pre class="is-size-7"><%= details %></pre>
        </div>
      </div>
    </div>
  <% } %>

  <div class="block">
    <div class="buttons is-centered">
      <a href="/" class="button is-primary">Go Home</a>
      <button type="button" id="back-button" class="button is-light">Go Back</button>
    </div>
  </div>
</div>

<script>
  // CSP-compliant event listener (no inline onclick)
  document.getElementById('back-button').addEventListener('click', function() {
    window.history.back();
  });
</script>
