<%- include('../layouts/base', { body: `
  <div class="content">
    <!-- Page Header -->
    <section class="block">
      <h1 class="title is-1">Bulma Components Demo</h1>
      <p class="subtitle">A showcase of Bulma components using the default color scheme</p>
    </section>

    <!-- Alerts Section -->
    <section class="block">
      <h2 class="title is-2">Notifications</h2>
      <div class="block">
        <div class="notification is-info">
          <button class="delete"></button>
          <strong>Info:</strong> This is an informational notification.
        </div>
      </div>

      <div class="block">
        <div class="notification is-success">
          <button class="delete"></button>
          <strong>Success:</strong> Your operation completed successfully!
        </div>
      </div>

      <div class="block">
        <div class="notification is-warning">
          <button class="delete"></button>
          <strong>Warning:</strong> Please review this before proceeding.
        </div>
      </div>

      <div class="block">
        <div class="notification is-danger">
          <button class="delete"></button>
          <strong>Error:</strong> Something went wrong!
        </div>
      </div>
    </section>

    <!-- Buttons Section -->
    <section class="block">
      <h2 class="title is-2">Buttons</h2>
      <div class="block">
        <div class="buttons">
          <button class="button is-primary">Primary</button>
          <button class="button is-link">Link</button>
          <button class="button is-info">Info</button>
          <button class="button is-success">Success</button>
          <button class="button is-warning">Warning</button>
          <button class="button is-danger">Danger</button>
        </div>
      </div>

      <div class="block">
        <div class="buttons">
          <button class="button is-primary is-outlined">Primary Outline</button>
          <button class="button is-link is-outlined">Link Outline</button>
          <button class="button is-info is-outlined">Info Outline</button>
        </div>
      </div>

      <div class="block">
        <div class="buttons">
          <button class="button is-small">Small</button>
          <button class="button">Normal</button>
          <button class="button is-large">Large</button>
        </div>
      </div>
    </section>

    <!-- Cards Section -->
    <section class="block">
      <h2 class="title is-2">Boxes (Cards)</h2>
      <div class="columns">
        <div class="column is-one-third">
          <div class="box">
            <h3 class="title is-5">Box Title</h3>
            <p>This is a basic box with title and content.</p>
            <div class="buttons is-right mt-4">
              <button class="button is-primary">Action</button>
            </div>
          </div>
        </div>

        <div class="column is-one-third">
          <div class="box">
            <div class="has-background-light has-text-centered" style="height: 12rem; display: flex; align-items: center; justify-content: center;">
              <span class="has-text-grey">Image Placeholder</span>
            </div>
            <h3 class="title is-5 mt-4">Box with Image</h3>
            <p>This box includes an image placeholder at the top.</p>
            <div class="buttons is-right mt-4">
              <button class="button is-primary">View</button>
            </div>
          </div>
        </div>

        <div class="column is-one-third">
          <div class="box">
            <h3 class="title is-5">
              Box with Tag
              <span class="tag is-info ml-2">NEW</span>
            </h3>
            <p>This box has a tag in the title.</p>
            <div class="buttons is-right mt-4">
              <span class="tag">Feature</span>
              <span class="tag">UI</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats Section -->
    <section class="block">
      <h2 class="title is-2">Stats</h2>
      <div class="columns">
        <div class="column">
          <div class="box has-text-centered">
            <div class="icon is-large has-text-primary mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
              </svg>
            </div>
            <p class="heading">Total Likes</p>
            <p class="title has-text-primary">25.6K</p>
            <p class="subtitle is-6">21% more than last month</p>
          </div>
        </div>

        <div class="column">
          <div class="box has-text-centered">
            <div class="icon is-large has-text-info mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <p class="heading">Page Views</p>
            <p class="title has-text-info">2.6M</p>
            <p class="subtitle is-6">21% more than last month</p>
          </div>
        </div>

        <div class="column">
          <div class="box has-text-centered">
            <div class="icon is-large has-text-success mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <p class="title">86%</p>
            <p class="heading">Tasks done</p>
            <p class="subtitle is-6 has-text-success">31 tasks remaining</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Forms Section -->
    <section class="block">
      <h2 class="title is-2">Form Elements</h2>
      <div class="box">
        <form>
          <div class="field">
            <label class="label">Text Input</label>
            <div class="control">
              <input class="input" type="text" placeholder="Type here">
            </div>
            <p class="help">Helper text goes here</p>
          </div>

          <div class="field">
            <label class="label">Select</label>
            <div class="control">
              <div class="select is-fullwidth">
                <select>
                  <option>Pick one</option>
                  <option>Option 1</option>
                  <option>Option 2</option>
                  <option>Option 3</option>
                </select>
              </div>
            </div>
          </div>

          <div class="field">
            <label class="label">Textarea</label>
            <div class="control">
              <textarea class="textarea" placeholder="Enter your message" rows="4"></textarea>
            </div>
          </div>

          <div class="field">
            <div class="control">
              <label class="checkbox">
                <input type="checkbox">
                Checkbox
              </label>
            </div>
          </div>

          <div class="field">
            <div class="control">
              <label class="checkbox">
                <input type="checkbox" checked>
                Toggle (using checkbox)
              </label>
            </div>
          </div>

          <div class="field">
            <label class="label">Radio Group</label>
            <div class="control">
              <label class="radio">
                <input type="radio" name="radio" checked>
                Option 1
              </label>
              <label class="radio">
                <input type="radio" name="radio">
                Option 2
              </label>
            </div>
          </div>

          <div class="field is-grouped is-grouped-right">
            <div class="control">
              <button type="button" class="button is-light">Cancel</button>
            </div>
            <div class="control">
              <button type="submit" class="button is-primary">Submit</button>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- Modal Section -->
    <section class="block">
      <h2 class="title is-2">Modal</h2>
      <div class="block">
        <button class="button" onclick="document.getElementById('demo-modal').classList.add('is-active')">Open Modal</button>
      </div>
      <div id="demo-modal" class="modal">
        <div class="modal-background" onclick="document.getElementById('demo-modal').classList.remove('is-active')"></div>
        <div class="modal-card">
          <header class="modal-card-head">
            <p class="modal-card-title">Modal Title</p>
            <button class="delete" aria-label="close" onclick="document.getElementById('demo-modal').classList.remove('is-active')"></button>
          </header>
          <section class="modal-card-body">
            <p>This is a modal dialog. Press ESC key or click the X button to close.</p>
          </section>
          <footer class="modal-card-foot">
            <button class="button" onclick="document.getElementById('demo-modal').classList.remove('is-active')">Close</button>
          </footer>
        </div>
      </div>
    </section>

    <!-- Table Section -->
    <section class="block">
      <h2 class="title is-2">Table</h2>
      <div class="table-container">
        <table class="table is-fullwidth is-striped">
          <thead>
            <tr>
              <th>#</th>
              <th>Name</th>
              <th>Status</th>
              <th>Role</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>1</td>
              <td>John Doe</td>
              <td><span class="tag is-success">Active</span></td>
              <td>Admin</td>
            </tr>
            <tr>
              <td>2</td>
              <td>Jane Smith</td>
              <td><span class="tag is-warning">Pending</span></td>
              <td>User</td>
            </tr>
            <tr>
              <td>3</td>
              <td>Bob Johnson</td>
              <td><span class="tag is-danger">Inactive</span></td>
              <td>User</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Badges/Tags Section -->
    <section class="block">
      <h2 class="title is-2">Tags</h2>
      <div class="block">
        <div class="tags">
          <span class="tag">neutral</span>
          <span class="tag is-primary">primary</span>
          <span class="tag is-link">link</span>
          <span class="tag is-info">info</span>
          <span class="tag is-success">success</span>
          <span class="tag is-warning">warning</span>
          <span class="tag is-danger">danger</span>
        </div>
      </div>

      <div class="block">
        <div class="tags">
          <span class="tag is-light">light</span>
          <span class="tag is-primary is-light">primary light</span>
          <span class="tag is-link is-light">link light</span>
          <span class="tag is-info is-light">info light</span>
        </div>
      </div>
    </section>

    <!-- Loading Section -->
    <section class="block">
      <h2 class="title is-2">Loading States</h2>
      <div class="block">
        <button class="button is-loading is-small">Small</button>
        <button class="button is-loading">Normal</button>
        <button class="button is-loading is-medium">Medium</button>
        <button class="button is-loading is-large">Large</button>
      </div>
      <div class="block">
        <button class="button is-loading is-primary">Primary Loading</button>
        <button class="button is-loading is-info">Info Loading</button>
        <button class="button is-loading is-success">Success Loading</button>
      </div>
    </section>
  </div>
` }) %>

<script>
  // Enable notification delete buttons
  document.addEventListener('DOMContentLoaded', function() {
    (document.querySelectorAll('.notification .delete') || []).forEach(function($delete) {
      var $notification = $delete.parentNode;
      $delete.addEventListener('click', function() {
        $notification.parentNode.removeChild($notification);
      });
    });

    // Close modal on ESC key
    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape') {
        document.querySelectorAll('.modal.is-active').forEach(function($modal) {
          $modal.classList.remove('is-active');
        });
      }
    });
  });
</script>
