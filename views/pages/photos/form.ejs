<%- include('../../layouts/base', {
  title: title + ' - Antithesis',
  body: `
    <!-- Breadcrumbs -->
    <nav class="breadcrumb mb-5" aria-label="breadcrumbs">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/albums">Albums</a></li>
        ${albumId ? `
          <li><a href="/albums/${albumId}">Album</a></li>
        ` : ''}
        ${photo ? `
          <li class="is-active"><a href="#" aria-current="page">Edit Photo</a></li>
        ` : `
          <li class="is-active"><a href="#" aria-current="page">New Photo</a></li>
        `}
      </ul>
    </nav>

    <!-- Form Box -->
    <div class="box" style="max-width: 48rem; margin: 0 auto;">
      <h1 class="title is-3 mb-5">${title}</h1>

      <form method="POST" action="${photo ? '/photos/' + photo.id : '/photos'}">
        <!-- Hidden Album ID -->
        ${albumId || (photo && photo.albumId) ? `
          <input type="hidden" name="albumId" value="${albumId || photo.albumId}" />
        ` : ''}

        <!-- Album Selection (only if creating new photo without albumId) -->
        ${!photo && !albumId ? `
          <div class="field">
            <label class="label">
              Album <span class="has-text-danger">*</span>
            </label>
            <div class="control">
              <input
                type="text"
                name="albumId"
                class="input"
                placeholder="Album ID"
                required
              />
            </div>
            <p class="help has-text-warning">Note: Select album from the album detail page for better experience</p>
          </div>
        ` : ''}

        <!-- Title Field -->
        <div class="field">
          <label class="label">
            Photo Title <span class="has-text-danger">*</span>
          </label>
          <div class="control">
            <input
              type="text"
              name="title"
              class="input"
              placeholder="Enter photo title"
              value="${photo ? photo.title : ''}"
              required
            />
          </div>
        </div>

        <!-- Description Field -->
        <div class="field">
          <label class="label">Description</label>
          <div class="control">
            <textarea
              name="description"
              class="textarea"
              placeholder="Enter photo description"
              rows="4"
            >${photo && photo.description ? photo.description : ''}</textarea>
          </div>
        </div>

        <!-- Photo URL Field -->
        <div class="field">
          <label class="label">
            Photo URL <span class="has-text-danger">*</span>
          </label>
          <div class="control">
            <input
              type="url"
              name="url"
              class="input"
              placeholder="https://example.com/photo.jpg"
              value="${photo && photo.url ? photo.url : ''}"
              required
            />
          </div>
          <p class="help">Provide a URL to the photo</p>
        </div>

        <!-- Thumbnail URL Field -->
        <div class="field">
          <label class="label">Thumbnail URL</label>
          <div class="control">
            <input
              type="url"
              name="thumbnailUrl"
              class="input"
              placeholder="https://example.com/thumbnail.jpg"
              value="${photo && photo.thumbnailUrl ? photo.thumbnailUrl : ''}"
            />
          </div>
          <p class="help">Optional: Provide a URL for the thumbnail</p>
        </div>

        <!-- Status Field -->
        <div class="field">
          <label class="label">Status</label>
          <div class="control">
            <div class="select is-fullwidth">
              <select name="status">
                <option value="draft" ${photo && photo.status === 'draft' ? 'selected' : !photo ? 'selected' : ''}>Draft</option>
                <option value="published" ${photo && photo.status === 'published' ? 'selected' : ''}>Published</option>
                <option value="archived" ${photo && photo.status === 'archived' ? 'selected' : ''}>Archived</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Form Actions -->
        <div class="field is-grouped is-grouped-right mt-5">
          <div class="control">
            <a href="${albumId ? '/albums/' + albumId : '/albums'}" class="button is-light">Cancel</a>
          </div>
          <div class="control">
            <button type="submit" class="button is-primary">
              ${photo ? 'Update Photo' : 'Add Photo'}
            </button>
          </div>
        </div>
      </form>
    </div>
  `
}) %>
