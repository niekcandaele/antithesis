<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Antithesis' %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body hx-boost="true">
  <%- include('../partials/header') %>

  <main class="section">
    <div class="container">
      <%- include('../partials/' + bodyPartial, {
        album: typeof album !== 'undefined' ? album : null,
        albums: typeof albums !== 'undefined' ? albums : null,
        photo: typeof photo !== 'undefined' ? photo : null,
        photos: typeof photos !== 'undefined' ? photos : null,
        title: typeof title !== 'undefined' ? title : null,
        currentTenantId: typeof currentTenantId !== 'undefined' ? currentTenantId : null,
        filters: typeof filters !== 'undefined' ? filters : null,
        statusCode: typeof statusCode !== 'undefined' ? statusCode : null,
        message: typeof message !== 'undefined' ? message : null,
        details: typeof details !== 'undefined' ? details : null
      }) %>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/htmx.min.js"></script>
  <script>
    // Configure htmx to swap content on 422 validation error responses
    document.body.addEventListener('htmx:beforeSwap', function(evt) {
      if (evt.detail.xhr.status === 422) {
        evt.detail.shouldSwap = true;
        evt.detail.isError = false;
      }
    });

    // Bulma notification dismiss functionality
    document.addEventListener('DOMContentLoaded', function() {
      function setupNotificationDismiss() {
        (document.querySelectorAll('.notification .delete') || []).forEach(($delete) => {
          const $notification = $delete.parentNode;
          $delete.addEventListener('click', () => {
            $notification.parentNode.removeChild($notification);
          });
        });
      }

      // Set up dismiss handlers on initial page load
      setupNotificationDismiss();

      // Re-attach handlers after htmx swaps in new content
      document.body.addEventListener('htmx:afterSwap', setupNotificationDismiss);
    });
  </script>
</body>
</html>
